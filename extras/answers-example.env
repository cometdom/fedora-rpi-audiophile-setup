# answers-example.env — every prompt override for `setup.sh --unattended`.
#
# Usage:
#   sudo ./setup.sh --unattended --answers my-answers.env
#
# Rules:
#   - Plain env file, sourced by setup.sh before any module runs.
#   - Every key is OPTIONAL: an unset key means the prompt's default, which
#     is the value shown in each comment below.
#   - Yes/no keys take Y or N. Menu keys take the same single letter/number
#     you would type at the prompt. Free-form keys take the literal text.
#   - An invalid value that a prompt loop keeps rejecting aborts the run
#     (fail-fast) instead of spinning forever.
#
# The set below reflects a typical headless appliance build; uncomment and
# adjust what you need.

# --- 01-kernel-rt -----------------------------------------------------------
#UA_KERNEL_RT=Y            # Install the PREEMPT_RT kernel (default Y)

# --- 02-system-tuning -------------------------------------------------------
#UA_TUNER_RERUN=N          # Re-run the DRUP tuner when already applied (default N)
#UA_NOSMT=N                # -nosmt tuner variant, disables SMT/HT (default N)

# --- 03-network-stack -------------------------------------------------------
#UA_NET_STABLE_NAMES=Y     # Stable NIC names by MAC (default Y)
#UA_NET_IFACE_PICK=        # NIC number in the roles menu (default: first)
#UA_NET_ROLES=Y            # Accept the proposed NIC roles (default Y)
#UA_NET_CONFIRM=Y          # Confirm the plan (default Y)
#UA_NET_STACK=K            # K=keep NetworkManager, s=systemd-networkd, n=skip (default K)
#UA_NET_CONTINUE=N         # Continue past warnings (default N)
#UA_DIRETTA_MTU=2          # 1=1500, 2=9014, 3=16128 (default 2)
#UA_MTU_RECONFIGURE=N      # Reconfigure an already-set Diretta MTU (default N)

# --- 04-tmpfs-disk ----------------------------------------------------------
#UA_TMPFS_VARLOG=Y         # /var/log + /var/tmp on tmpfs (default Y)

# --- 05-services-cleanup ----------------------------------------------------
#UA_FIREWALLD_DISABLE=Y    # Disable firewalld (default Y)
#UA_SELINUX_DISABLE=Y      # Disable SELinux (default Y)

# --- 06-cpu-states ----------------------------------------------------------
#UA_CPU_CAP=N              # Cap the CPU max frequency, opt-in (default N)
#UA_CPU_CAP_KEEP=Y         # Keep an existing cap (default Y)
#UA_CPU_CAP_PCT=           # Cap percent 1-100 (default: suggested value)
#UA_CPU_FREQ_PIN=N         # Pin per-core frequencies, advanced (default N)
#UA_CPU_FREQ_PIN_KEEP=Y    # Keep existing pins (default Y)
#UA_CPU_FREQ_OVERRIDES=    # core:freq_khz,... (default: keep/skip)
#UA_CPU_POLL=N             # Poll-mode on specific cores, advanced (default N)
#UA_CPU_POLL_KEEP=Y        # Keep existing poll-mode cores (default Y)
#UA_CPU_POLL_CORES=        # Cores list (default: keep/skip)

# --- 10-install-drup --------------------------------------------------------
#UA_DRUP_INSTALL=Y         # Install DirettaRendererUPnP (default Y)
#UA_DRUP_RERUN=N           # Re-run its install.sh when present (default N)
#UA_DRUP_CLANG_LTO=Y       # Build with Clang + LTO (default Y)
#UA_DRUP_WEBUI=Y           # Web config UI on port 8080 (default Y)
#UA_DRUP_DEVICE_PICK=      # Diretta device number (default 1)

# --- 11-install-slim2diretta ------------------------------------------------
#UA_S2D_INSTALL=Y          # Install slim2Diretta (default Y)
#UA_S2D_RERUN=N            # Re-run its install.sh when present (default N)
#UA_S2D_CLANG_LTO=Y        # Build with Clang + LTO (default Y)
#UA_S2D_DEVICE_PICK=       # Diretta device number (default 1)
#UA_S2D_LMS_IP=            # LMS IP; empty = Slimproto auto-discovery

# --- 12-install-slim2upnp ---------------------------------------------------
#UA_S2U_INSTALL=N          # Install slim2UPnP (default N)
#UA_S2U_SOURCE_BUILD=N     # Build from source instead of prebuilt (default N)
#UA_S2U_RERUN=N            # Re-run its install.sh when present (default N)

# --- 13-pi-tweaks -----------------------------------------------------------
#UA_PI_TWEAKS=N            # Apply optional Pi hardware tweaks (default N)
#UA_PI_TWEAKS_WIFI_BT=N    # Disable onboard Wi-Fi + Bluetooth (default N)
#UA_PI_TWEAKS_HDMI=N       # Disable HDMI video output — HEADLESS only (default N)

# --- 14-ram-mode ------------------------------------------------------------
#UA_RAM_MODE_ACTION=N      # e=enable, d=disable, p=persistent paths, N=skip (default N)
#UA_RAM_MODE_STRATEGY=V    # o=overlayfs full root, V=systemd.volatile (default V)
#UA_RAM_MODE_ENABLE=N      # Final confirmation (default N)
#UA_RAM_DISABLE_REBOOT=Y   # Reboot immediately after disable (default Y)
# Persistent paths (action=p) — bind-mount an app's mutable state onto real
# disk so it survives RAM-mode reboots. Preset apps only; removing an
# arbitrary configured pair is inherently per-install and has no UA_<KEY> —
# see modules/14-ram-mode.sh's _ram_do_persist.
#UA_RAM_PERSIST_LMS=N      # Persist Lyrion Music Server's /var/lib/lyrionmusicserver (default N)
#UA_RAM_PERSIST_TUNE=N     # Persist Tune Server's /opt/tune (binary + data, self-update included) (default N)
#UA_RAM_PERSIST_CUSTOM=N   # Add a custom source:target pair not in the preset list (default N)
#UA_RAM_PERSIST_CUSTOM_SOURCE=  # Only asked if CUSTOM=Y, e.g. /home/myapp-data
#UA_RAM_PERSIST_CUSTOM_TARGET=  # Only asked if CUSTOM=Y, e.g. /var/lib/myapp
#UA_RAM_PERSIST_REMOVE=N   # Offer to remove an already-configured pair (default N)

# --- 99-finalize ------------------------------------------------------------
#UA_REBOOT=N               # Reboot at the end (default N)
